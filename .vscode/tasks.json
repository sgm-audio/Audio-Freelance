{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch Audio-Freelance",
      "type": "shell",
      "command": "python run.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Preflight Audio-Freelance",
      "type": "shell",
      "command": "python run.py --check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
